# ============================================
# 服务模式（--serve）环境变量 — 复制为 .env.serve
# ============================================
# 重要：本文件绝不能出现 PRIVATE_KEY / PRIVATE_KEYS。
# --serve 启动时会断言环境中没有私钥，检测到即拒绝启动。
# 执行 mint 仍在另一个终端用 .env（含私钥）跑 --batch。

SERVE_HOST=127.0.0.1
SERVE_PORT=8787

# 调度
SCAN_CHAINS=robinhood,arc
SCAN_INTERVAL_MIN=15
SCAN_LIMIT=20
SCAN_LOOKBACK_DAYS=0.5
SCAN_HORIZON_HOURS=72
SCAN_INCLUDE_MINTS=0

# RPC：eth_call 用（可留空走公共节点）
RPC_URL_ROBINHOOD=
RPC_URL_ARC=

# 扫描专用（宽 eth_getLogs 范围的付费节点时填写；留空自动用公共端点）
SCAN_RPC_URL_ROBINHOOD=
SCAN_RPC_URL_ARC=

# OpenSea（可选：地板价 stats 与合约→slug 反查）
OPENSEA_API_KEY=
