node_modules/
dist/
*.log

# Secrets — never commit
.env
.env.*
!.env.example
!.env.serve.example
.env.serve

# Serve-mode exports (generated by the dashboard)
exports/

# Batch config that may embed RPC keys — keep it local
targets.local.json

# Audit scan cache — rebuilt on demand
.audit-cache/

# Discovery scanner state and history
.scan-state.json
.scan-history.jsonl
.scan-state.json.tmp

# Batch execution ledger (guards against sending twice after a restart)
.batch-state.json
.batch-state.json.tmp

# Private keys — never commit
wallets/
keys.txt
*.key

# Auto-derived smart-minter set (local state)
.smart-minters.json

# User favorites (local decisions, not scan state)
.favorites.json

# Cross-process wallet locks
.locks/
