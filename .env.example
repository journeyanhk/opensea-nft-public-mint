# ============================================
# NFT Public Mint — 可选配置
# ============================================
# 本文件中的所有值都是可选的。向导会询问必要信息；
# 以下值仅作为预填默认值使用。
#
# 复制为 .env：   cp .env.example .env
#
# 私钥可选：可在 CLI 中隐藏粘贴，或填入 .env。
# .env 中的私钥为明文。不要分享或提交 .env 文件。
# 单个钱包（可带或不带 0x 前缀）：
PRIVATE_KEY=
# 多个钱包，用逗号分隔。重复的私钥会被跳过。
PRIVATE_KEYS=

# --- RPC endpoint（推荐）---
# 私有 RPC 是参与竞争性 mint 的关键因素。公共节点
# 仍可用，但通常更慢且受频率限制。
# 为每条需要 mint 的链设置一个 RPC。也可以在程序询问时粘贴 RPC。
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ROBINHOOD=
RPC_URL_ARC=

# --- 扫描专用 RPC（可选）---
# --scan/--audit 的日志扫描需要宽的 eth_getLogs 范围；发送交易最优的私有节点
# （例如 Alchemy 免费档只允许 10 块范围）往往最不适合扫描。留空时扫描优先用公共节点，
# 私有节点仅作回退。有付费节点时可在此固定。
SCAN_RPC_URL_ETHEREUM=
SCAN_RPC_URL_BASE=
SCAN_RPC_URL_ROBINHOOD=
SCAN_RPC_URL_ARC=

# --- 菜单中默认选中的链 ---
# ethereum | base | robinhood | arc
CHAIN=base

# --- 默认 gas 值（gwei，可选）---
# 留空则按链默认值预填：ethereum 80/5、base 2/0.05、robinhood 2/0.05、arc 40/0。
# Arc 的 base fee 约 20 gwei，max fee 低于它会被节点直接拒收。
# 程序会预填这些值；每次运行你可以确认或修改。
# Max fee 是上限，不是实际支付费用。实际费用为 base fee + tip。
# 注意：节点会按 gasLimit × maxFee 预占，因此钱包余额需满足该金额。
# MAX_FEE_PER_GAS=2
# MAX_PRIORITY_FEE=0.05

# 每笔 mint 交易的 gas limit。通过 SeaDrop mint 1 个 NFT 通常约用 135k。
GAS_LIMIT=250000

# --- OpenSea REST API key（可选）---
# 仅用于将 collection slug 转换为合约地址。OpenSea 可能要求
# API key 才能执行该操作。直接粘贴 0x 合约地址始终可用，
# 无需 key。mint 过程不会联系 OpenSea。
# 免费获取 key：https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=

# --- OpenSea drops 日历（可选）---
# --scan 每隔多少分钟抓一次 OpenSea 的 drops 日历（upcoming 的提前量与地板/认证）。
# 默认 15；页面约 1 MB，不建议低于 10。
CALENDAR_INTERVAL_MIN=15

# --- 执行数量与速度（可选；队列执行器请写在 .env.executor）---
# 免费 drop：每钱包 mint min(链上 per-wallet 上限, 本值)；收费固定 1 个；0 关闭该策略。
# 供应紧张（剩余 < 20×期望数量）或带 batch-mint/instant-sellout 标记时自动降为 1。
FREE_MAX_QUANTITY=10
# 显式 burst（2..5）优先于下面的自动规则；留空 = 不显式指定
BURST_COUNT=
# 免费且链上每钱包上限为 1 的目标自动连发 3 笔（cap=1 无过铸风险）；0 关闭
BURST_AUTO_FREE_CAP1=1
# 付费/多枚上限的目标要连发时必须显式允许可能买到多份
BURST_ALLOW_OVERSHOOT=0

# --- 通知（可选，默认关闭；失败静默）---
# 任务结束 / 执行器心跳停滞 / 日历金丝雀；Telegram sendMessage 或任意 JSON webhook
NOTIFY_WEBHOOK=
NOTIFY_TELEGRAM_CHAT_ID=

# --- X（Twitter）粉丝数（可选，默认关闭）---
# 设为 1 时，--refresh-targets 会通过 api.fxtwitter.com 读取合集 X 账号的粉丝数，
# 结果缓存 24 小时；失败静默，不影响其它字段。
ENABLE_X_METRICS=
