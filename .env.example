# ============================================
# NFT Public Mint — 可选配置
# ============================================
# 本文件中的所有值都是可选的。向导会询问必要信息；
# 以下值仅作为预填默认值使用。
#
# 复制为 .env：   cp .env.example .env
#
# 私钥可选：可在 CLI 中隐藏粘贴，或填入 .env。
# .env 中的私钥为明文。不要分享或提交 .env 文件。
# 单个钱包（可带或不带 0x 前缀）：
PRIVATE_KEY=
# 多个钱包，用逗号分隔。重复的私钥会被跳过。
PRIVATE_KEYS=

# --- RPC endpoint（推荐）---
# 私有 RPC 是参与竞争性 mint 的关键因素。公共节点
# 仍可用，但通常更慢且受频率限制。
# 为每条需要 mint 的链设置一个 RPC。也可以在程序询问时粘贴 RPC。
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ROBINHOOD=
RPC_URL_ARC=

# --- 扫描专用 RPC（可选）---
# --scan/--audit 的日志扫描需要宽的 eth_getLogs 范围；发送交易最优的私有节点
# （例如 Alchemy 免费档只允许 10 块范围）往往最不适合扫描。留空时扫描优先用公共节点，
# 私有节点仅作回退。有付费节点时可在此固定。
SCAN_RPC_URL_ETHEREUM=
SCAN_RPC_URL_BASE=
SCAN_RPC_URL_ROBINHOOD=
SCAN_RPC_URL_ARC=

# --- 菜单中默认选中的链 ---
# ethereum | base | robinhood | arc
CHAIN=base

# --- 默认 gas 值（gwei，可选）---
# 留空则按链默认值预填：ethereum 80/5、base 2/0.05、robinhood 2/0.05、arc 40/0。
# Arc 的 base fee 约 20 gwei，max fee 低于它会被节点直接拒收。
# 程序会预填这些值；每次运行你可以确认或修改。
# Max fee 是上限，不是实际支付费用。实际费用为 base fee + tip。
# 注意：节点会按 gasLimit × maxFee 预占，因此钱包余额需满足该金额。
# MAX_FEE_PER_GAS=2
# MAX_PRIORITY_FEE=0.05

# 每笔 mint 交易的 gas limit。通过 SeaDrop mint 1 个 NFT 通常约用 135k。
GAS_LIMIT=250000

# --- OpenSea REST API key（可选）---
# 仅用于将 collection slug 转换为合约地址。OpenSea 可能要求
# API key 才能执行该操作。直接粘贴 0x 合约地址始终可用，
# 无需 key。mint 过程不会联系 OpenSea。
# 免费获取 key：https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=
